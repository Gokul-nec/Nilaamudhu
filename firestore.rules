rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify if the requesting user is an authorized admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == "admin";
    }

    // Site settings: anyone can read; only admins can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: public can read active categories; admins have full access
    match /categories/{categoryId} {
      allow read: if resource.data.is_active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Products: public can read active products; admins have full access
    match /products/{productId} {
      allow read: if resource.data.status == "active" || isAdmin();
      allow write: if isAdmin();
    }

    // Admin users collection: strictly restricted to authenticated admins
    match /admin_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
